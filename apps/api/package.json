{
  "name": "@exhibit/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "migrate": "tsx --env-file=.env src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "smoke": "tsx --env-file=.env src/scripts/liveSmoke.ts",
    "smoke:canvas": "tsx --env-file=.env src/scripts/liveCanvasSmoke.ts"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@exhibit/contracts": "workspace:*",
    "@exhibit/database": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.5",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.5"
  }
}
