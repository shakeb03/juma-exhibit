# Railway API service. Copy to .env for local development. Never commit real values.

# Neon: pooled connection for API queries, direct connection for migrations and the job runner.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Shared secret between the Vercel proxy and this API.
BACKEND_PROXY_SECRET=change-me-long-random-string

# Origin of the web app (exact match, used for CORS on direct upload routes).
APP_ORIGIN=http://localhost:3000

OPENROUTER_API_KEY=sk-or-placeholder

# Optional
PORT=8080
# Set automatically on Railway (RAILWAY_GIT_COMMIT_SHA); used for the version endpoint and run records.
# GIT_COMMIT=
# Directory with SQL migrations (auto-detected from the repo root or apps/api by default).
# MIGRATIONS_DIR=

# Code browser (the geek panel's source view). Leave unset to show "not configured".
# REPO_OWNER=
# REPO_NAME=
# REPO_TOKEN=            # optional for a public repository
# REPO_DEFAULT_BRANCH=main
